{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo skip-install",
  "buildCommand": "echo skip-build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/fuyulev",
      "destination": "/fuyuu/",
      "permanent": true
    },
    {
      "source": "/fuyulev/",
      "destination": "/fuyuu/",
      "permanent": true
    },
    {
      "source": "/fuyulev/:path*",
      "destination": "/fuyuu/:path*",
      "permanent": true
    },
    {
      "source": "/koharu",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/koharu/",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/koharu/:path*",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/shiotsuki",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/shiotsuki/",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/shiotsuki/:path*",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/tianhu",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/tianhu/",
      "destination": "/fuyuu/",
      "permanent": false
    },
    {
      "source": "/tianhu/:path*",
      "destination": "/fuyuu/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/fuyuu/assets/images/covers/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/kaya/assets/images/covers/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fuyuu/js/site-data.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/kaya/js/site-data.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/fuyuu/js/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/fuyuu/js/gallery-images.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/fuyuu/css/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/kaya/js/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/kaya/css/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/fuyuu/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/kaya/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fuyuu/data/images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/fuyuu/image/thumbs/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fuyuu/image/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/kaya/data/images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
